{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "phase": {
      "additionalProperties": false,
      "properties": {
        "manifest": {"$ref": "comparison-artifacts-schema.json#/$defs/digest"},
        "metadata": {"$ref": "comparison-artifacts-schema.json#/$defs/digest"},
        "profile": {"$ref": "comparison-artifacts-schema.json#/$defs/digest"},
        "prompt": {"$ref": "comparison-artifacts-schema.json#/$defs/digest"},
        "stderr": {"$ref": "comparison-artifacts-schema.json#/$defs/digest"},
        "trace": {"$ref": "comparison-artifacts-schema.json#/$defs/digest"}
      },
      "required": ["trace", "stderr", "metadata", "prompt", "manifest", "profile"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "comparison_binding": {"$ref": "comparison-artifacts-schema.json#/$defs/comparisonBinding"},
    "event": {"const": "deliver_eval_arm_finalized"},
    "output_freeze_sha256": {"$ref": "comparison-artifacts-schema.json#/$defs/digest"},
    "phase_bindings": {
      "additionalProperties": false,
      "properties": {
        "pre-packet": {"$ref": "#/$defs/phase"},
        "remediation": {"$ref": "#/$defs/phase"}
      },
      "required": ["pre-packet", "remediation"],
      "type": "object"
    },
    "schema_version": {"const": 1}
  },
  "required": ["schema_version", "comparison_binding", "event", "output_freeze_sha256", "phase_bindings"],
  "type": "object"
}
