{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "implementation_diff": {"minLength": 1, "type": "string"},
        "probe_results": {"minLength": 1, "type": "string"},
        "review_log": {"minLength": 1, "type": "string"},
        "review_rounds": {"minLength": 1, "type": "string"},
        "test_diff": {"minLength": 1, "type": "string"}
      },
      "required": ["implementation_diff", "test_diff", "probe_results", "review_log", "review_rounds"],
      "type": "object"
    },
    "identity_clues": {"items": {"minLength": 1, "pattern": ".*\\S.*", "type": "string"}, "type": "array"},
    "measurements": {
      "additionalProperties": false,
      "properties": {
        "full_review_rounds": {"minimum": 0, "type": "integer"},
        "targeted_rereviews": {"minimum": 0, "type": "integer"},
        "test_count": {"minimum": 0, "type": "integer"},
        "test_size_lines": {"minimum": 0, "type": "integer"},
        "wall_time_seconds": {"minimum": 2, "type": "integer"}
      },
      "required": ["test_count", "test_size_lines", "full_review_rounds", "targeted_rereviews", "wall_time_seconds"],
      "type": "object"
    },
    "scenario_id": {"enum": ["retry-failed", "preflight-remediation-holdout"]}
  },
  "required": ["scenario_id", "evidence", "measurements", "identity_clues"],
  "type": "object"
}
