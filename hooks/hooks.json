{
  "description": "Runtime guardrails for full Clarifier passes.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/clarifier_dispatch_gate.py\"",
            "timeout": 3,
            "statusMessage": "Preparing Clarifier revision"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/clarifier_dispatch_gate.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/clarifier_dispatch_gate.py\"",
            "timeout": 3,
            "statusMessage": "Checking Clarifier revision"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/clarifier_dispatch_gate.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
